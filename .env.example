# Environment Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nimi_kings_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="nimi_kings_super_secret_access_jwt_key_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="nimi_kings_super_secret_refresh_jwt_key_2026"
JWT_REFRESH_EXPIRATION="7d"

# Redis & Queues
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Object Storage (S3 / MinIO)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="nimi-kings-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
CDN_BASE_URL="https://cdn.nimikingsltd.com"
